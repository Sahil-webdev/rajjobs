# MongoDB connection (local or Atlas)
MONGO_URI=mongodb://localhost:27017/rajjobs
MONGO_DB_NAME=rajjobs

# JWT secrets
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_another_long_random_string
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# App
PORT=4000
FRONTEND_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003
BACKEND_URL=http://localhost:4000
# Public canonical URL used by the classic HTML exam renderer
PUBLIC_SITE_URL=https://www.rajjobs.com

# Cloudflare R2 — backend/VPS only. Never put real values in this template
# or in a frontend NEXT_PUBLIC_* variable.
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=rajjobs-images
R2_ENDPOINT=https://your_r2_account_id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://cdn.rajjobs.com
